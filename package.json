{
  "name": "cramzz-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:hub": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "vendor:experiments": "node scripts/vendor-experiments.mjs",
    "build": "npm run check && npm run test && npm run scan:secrets && npm run build:hub && npm run vendor:experiments",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "preview:e2e": "node scripts/preview-static.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "astro": "7.3.3",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.1",
    "vitest": "4.1.11"
  }
}
